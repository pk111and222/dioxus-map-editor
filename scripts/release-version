#!/usr/bin/env python3
"""Plan a crate release only when root package.version changed across a main push."""
import argparse
import json
from pathlib import Path
import re
import subprocess


def version(manifest):
    # The root release contract uses a literal package.version, not workspace inheritance.
    package = re.search(r"(?ms)^\[package\]\s*$(.*?)(?=^\[|\Z)", manifest)
    found = re.search(r'(?m)^version\s*=\s*"([^"\n]+)"\s*(?:#.*)?$', package[1] if package else "")
    if not found:
        raise ValueError("root manifest must contain a literal [package] version")
    value = found[1]
    if not re.fullmatch(r"(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(?:-[0-9A-Za-z.-]+)?", value):
        raise ValueError("package.version must be a Cargo SemVer without build metadata")
    semver_key(value)
    return value


def version_at(ref):
    if not ref or not ref.strip("0"):
        return None
    commit = subprocess.run(["git", "rev-parse", "--verify", ref + "^{commit}"], check=True, capture_output=True, text=True).stdout.strip()
    exists = subprocess.run(["git", "cat-file", "-e", commit + ":Cargo.toml"], capture_output=True)
    if exists.returncode:
        return None  # Initial repository commit may predate Cargo initialization.
    return version(subprocess.run(["git", "show", commit + ":Cargo.toml"], check=True, capture_output=True, text=True).stdout)


def semver_key(value):
    parts = value.split("-", 1)
    if len(parts) == 1:
        return (1, ())
    identifiers = parts[1].split(".")
    if any(not p or (p.isdigit() and len(p) > 1 and p[0] == "0") for p in identifiers):
        raise ValueError("invalid SemVer prerelease")
    return (0, tuple((0, int(p)) if p.isdigit() else (1, p) for p in identifiers))


def plan(before, current):
    if before is not None and current != before:
        old = tuple(map(int, before.split("-")[0].split(".")))
        new = tuple(map(int, current.split("-")[0].split(".")))
        if new < old or (new == old and semver_key(current) < semver_key(before)):
            raise ValueError("refusing a version downgrade")
    return {"changed": before != current, "version": current, "previous": before}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("before", help="github.event.before, empty or zero SHA for initial push")
    parser.add_argument("head", nargs="?", default="HEAD")
    parser.add_argument("--output", type=Path, help="GitHub Actions output file")
    args = parser.parse_args()
    result = plan(version_at(args.before), version_at(args.head))
    if result["version"] is None:
        raise ValueError("head has no root Cargo package")
    print(json.dumps(result))
    if args.output:
        with args.output.open("a") as output:
            output.write("changed=" + str(result["changed"]).lower() + "\n")
            output.write("version=" + result["version"] + "\n")


if __name__ == "__main__":
    main()
